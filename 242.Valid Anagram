class Solution {
public:
    bool isAnagram(string s, string t) {
        if(s.size()!=t.size()) return false;
        map<char,int>mp;
        int i=0;
        for(i=0;i<s.size();i++){
            mp[s[i]]++;
        }
        for(i=0;i<t.size();i++){
            mp[t[i]]--;
        }
      for(auto x : mp) {
        if(x.second!=0) return false;
}
        return true;
    }
};
